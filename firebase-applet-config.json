# Frontend runtime variables for the Vite app.
# Keep all real secrets in the hosting provider's secret manager or server runtime,
# not inside the repository or browser bundle.

VITE_APP_ENV=development
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Optional provider configuration (do not set service-role keys in the browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GEMINI_API_KEY=
VITE_CLOUDFLARE_API_TOKEN=
