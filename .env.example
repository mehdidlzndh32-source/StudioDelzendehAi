rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && request.auth.token.role == 'owner';
    }

    function isAccountant() {
      return isOwner() || (isSignedIn() && request.auth.token.role == 'accountant');
    }

    match /users/{userId} {
      allow read: if isOwner() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner() || (
        isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt'])
      );
      allow delete: if isOwner();
    }

    match /development_fund/{entryId} {
      allow read: if isAccountant();
      allow create: if isAccountant()
        && request.resource.data.status == 'draft'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.submittedBy == request.auth.uid;
      allow update: if isOwner()
        && resource.data.status == 'draft'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt'])
        && request.resource.data.approvedBy == request.auth.uid;
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isOwner();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['action', 'actor', 'details', 'timestamp'])
        && request.resource.data.actor == request.auth.uid
        && request.resource.data.action is string;
      allow update, delete: if false;
    }

    // No public test endpoint or implicit access; all remaining paths are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
